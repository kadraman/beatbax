## nes_dmc_demo.bax
## NES APU full-kit demo — exercises all bundled DPCM samples alongside the noise channel.
##
## Purpose: verify and arrange every built-in @nes/ DPCM sample in a musical context.
## Channel 4 (noise) drives hi-hats and snare colour; channel 5 (DMC) drives all
## pitched/sampled percussion.  Each classic hit is also shown with local:/github:
## sample-source syntaxes. Note: "local:" instruments will not resolve in the Web UI.
##
## Bundled DMC samples covered:
##   Classic: kick, snare, clap, bongos, toms
##   Feature 109 perc: kick_punch, kick_body, snare_tight, snare_fat,
##     hat_closed, hat_open, crash, crash_cym, rim, shaker, cowbell
##   808 (Fischer): kick/snare/hat/hat_open/clap/cymbal/rim/cowbell/maracas/toms
##   909: kick_909, snare_909, hat_909, hat_open_909
##   Bass: bass_saw_c0/d0/e0/g0/a0/c1 (@nes/bass → c1)
##   Special: orch_hit, orch_hit_up, Kenney voices (+ voice_ready @ rate 12)
##
## Song structure (1 bar = 8 steps at 120 BPM, 4/4; most sections ×2):
##   A  kick/snare groove (punch/tight)
##   B  snare + clap
##   C  bongo call-and-response (+ local/github)
##   D  classic tom cascade
##   E  bass pulse (c0/e0/c1 + slow)
##   F  mixed kit + orch_up
##   G  DMC hats vs clap
##   H  voices (go / correct / ready@12)
##   I  body/fat/crash/rim/shaker/cowbell
##   J  808 groove
##   K  808 toms + perc
##   L  909 groove + cymbal
##   M  bass ladder (all C0–C1 notes)
##   N  remaining Kenney voices
##   Bonus — @nes / local: / github: source showcase

chip nes
bpm 120

# =============================================================================
# Instruments
# =============================================================================

# ── Noise channel (ch4) ──────────────────────────────────────────────────────
inst n_hat_c     type=noise  noise_mode=normal  noise_period=1   env=9,down   env_period=0
inst n_hat_o     type=noise  noise_mode=normal  noise_period=2   env=9,down   env_period=2
inst snare_n     type=noise  noise_mode=normal  noise_period=6   env=13,down  env_period=1
inst rim_n       type=noise  noise_mode=normal  noise_period=12  env=11,down  env_period=0

# ── Classic + punch kit ──────────────────────────────────────────────────────
inst kick        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/kick_punch"
inst kick_body   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/kick_body"
inst kick_classic type=dmc dmc_rate=15  dmc_loop=false  dmc_sample="@nes/kick"
inst kick_loc    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/kick.dmc"
inst kick_gh     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/kick.dmc"

inst snare_d     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/snare_tight"
inst snare_fat   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/snare_fat"
inst snare_classic type=dmc dmc_rate=15 dmc_loop=false  dmc_sample="@nes/snare"
inst snare_loc   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/snare.dmc"
inst snare_gh    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/snare.dmc"

inst clap        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/clap"
inst clap_loc    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/clap.dmc"
inst clap_gh     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/clap.dmc"

inst bongo       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bongo"
inst bongo_loc   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/bongo.dmc"
inst bongo_gh    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/bongo.dmc"
inst mbongo      type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/muted_bongo"
inst mbongo_loc  type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/muted_bongo.dmc"
inst mbongo_gh   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/muted_bongo.dmc"

inst htom        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/high_tom"
inst htom_loc    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/high_tom.dmc"
inst htom_gh     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/high_tom.dmc"
inst mtom        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/middle_tom"
inst mtom_loc    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/middle_tom.dmc"
inst mtom_gh     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/middle_tom.dmc"
inst ltom        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/low_tom"
inst ltom_loc    type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="local:samples/dmc/low_tom.dmc"
inst ltom_gh     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="github:kadraman/beatbax-samples/dmc/low_tom.dmc"

# ── Feature 109 perc extras ──────────────────────────────────────────────────
inst dhat        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_closed"
inst dhat_o      type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_open"
inst crash       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/crash"
inst crash_cym   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/crash_cym"
inst dmc_rim     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/rim"
inst shaker      type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/shaker"
inst cowbell     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/cowbell"

# ── Full 808 kit ─────────────────────────────────────────────────────────────
inst k808        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/kick_808"
inst s808        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/snare_808"
inst h808        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_808"
inst ho808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_open_808"
inst cl808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/clap_808"
inst cy808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/cymbal_808"
inst rs808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/rim_808"
inst cb808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/cowbell_808"
inst ma808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/maracas_808"
inst lt808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/tom_low_808"
inst mt808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/tom_mid_808"
inst ht808       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/tom_high_808"

# ── 909 kit ──────────────────────────────────────────────────────────────────
inst k909        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/kick_909"
inst s909        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/snare_909"
inst h909        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_909"
inst ho909       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/hat_open_909"

# ── Bass / orch / voice ──────────────────────────────────────────────────────
inst bass        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_c1"
inst bass_c0     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_c0"
inst bass_d0     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_d0"
inst bass_e0     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_e0"
inst bass_g0     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_g0"
inst bass_a0     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/bass_saw_a0"
inst bass_slow   type=dmc  dmc_rate=4   dmc_loop=false  dmc_sample="@nes/bass_saw_c0"
inst orch        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/orch_hit"
inst orch_up     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/orch_hit_up"
inst v_go        type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_go"
inst v_correct   type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_correct"
inst v_set       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_set"
inst v_hurry     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_hurry_up"
inst v_level     type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_level_up"
inst v_gogo      type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_go_go_go"
inst v_win       type=dmc  dmc_rate=15  dmc_loop=false  dmc_sample="@nes/voice_you_win"
inst v_ready     type=dmc  dmc_rate=12  dmc_loop=false  dmc_sample="@nes/voice_ready"

# =============================================================================
# Patterns (8 events = 1 bar)
# =============================================================================

# ── A — kick groove ──────────────────────────────────────────────────────────
pat a_dmc  = kick . snare_d . kick . snare_d .
pat a_hat  = n_hat_c n_hat_c snare_n n_hat_c n_hat_c n_hat_c snare_n n_hat_c

# ── B — snare + clap ─────────────────────────────────────────────────────────
pat b_dmc  = kick clap snare_d . kick clap snare_d clap
pat b_hat  = n_hat_c n_hat_o n_hat_c n_hat_c n_hat_c n_hat_o n_hat_c n_hat_o

# ── C — bongo call-and-response ──────────────────────────────────────────────
pat c_dmc  = bongo mbongo bongo mbongo bongo_loc mbongo_loc bongo_gh mbongo_gh
pat c_hat  = . rim_n . rim_n . rim_n . rim_n

# ── D — classic tom cascade ──────────────────────────────────────────────────
pat d_dmc  = htom mtom ltom mtom htom mtom ltom htom
pat d_hat  = n_hat_c . . . n_hat_c . . .

# ── E — bass pulse ───────────────────────────────────────────────────────────
pat e_dmc  = bass_c0 . bass_e0 . bass . bass_slow .
pat e_hat  = n_hat_c . n_hat_c n_hat_o n_hat_c . n_hat_c n_hat_o

# ── F — mixed kit + orch ─────────────────────────────────────────────────────
pat f_dmc  = kick htom snare_d bongo clap orch_up snare_d htom
pat f_hat  = n_hat_c n_hat_c snare_n n_hat_c n_hat_c n_hat_c snare_n n_hat_o

# ── G — DMC hats vs clap ─────────────────────────────────────────────────────
pat g_dmc  = dhat clap dhat_o clap dhat clap dhat_o .
pat g_hat  = . . . . . . . .

# ── H — voices (go / correct / ready@12) ─────────────────────────────────────
pat h_dmc  = v_go . v_correct . v_ready . . .
pat h_hat  = . . . . . . . .

# ── I — body / fat / crash / rim / shaker / cowbell ──────────────────────────
pat i_dmc  = kick_body snare_fat crash . dmc_rim shaker cowbell crash_cym
pat i_hat  = n_hat_c . snare_n . n_hat_c . snare_n .

# ── J — 808 groove ───────────────────────────────────────────────────────────
pat j_dmc  = k808 h808 s808 h808 k808 cl808 s808 ho808
pat j_hat  = . . . . . . . .

# ── K — 808 toms + perc ──────────────────────────────────────────────────────
pat k_dmc  = ht808 mt808 lt808 rs808 ma808 cb808 cy808 k808
pat k_hat  = n_hat_c . . . n_hat_c . . .

# ── L — 909 groove ───────────────────────────────────────────────────────────
pat l_dmc  = k909 h909 s909 h909 k909 ho909 s909 cy808
pat l_hat  = . . . . . . . .

# ── M — bass ladder (all pitched notes) ──────────────────────────────────────
pat m_dmc  = bass_c0 bass_d0 bass_e0 bass_g0 bass_a0 bass . orch
pat m_hat  = . . . . . . . .

# ── N — remaining Kenney voices ──────────────────────────────────────────────
pat n_dmc  = v_set . v_hurry . v_level . v_gogo .
pat n_hat  = . . . . . . . .
pat n2_dmc = v_win . kick_classic snare_classic . . . .
pat n2_hat = . . . . . . . .

# ── Bonus — sample-source showcase ───────────────────────────────────────────
pat src_kick  = kick kick_loc kick_gh kick kick_loc kick_gh kick kick_gh
pat src_snare = snare_d snare_loc snare_gh snare_d snare_loc snare_gh snare_d snare_gh
pat src_clap  = clap clap_loc clap_gh clap clap_loc clap_gh clap clap_gh
pat src_tom   = htom htom_loc mtom mtom_loc ltom ltom_loc htom_gh ltom_gh

# =============================================================================
# Sequences
# =============================================================================

seq dmc_seq = a_dmc a_dmc b_dmc b_dmc c_dmc c_dmc d_dmc d_dmc e_dmc e_dmc f_dmc f_dmc g_dmc g_dmc h_dmc h_dmc i_dmc i_dmc j_dmc j_dmc k_dmc k_dmc l_dmc l_dmc m_dmc m_dmc n_dmc n2_dmc src_kick src_snare src_clap src_tom
seq hat_seq = a_hat a_hat b_hat b_hat c_hat c_hat d_hat d_hat e_hat e_hat f_hat f_hat g_hat g_hat h_hat h_hat i_hat i_hat j_hat j_hat k_hat k_hat l_hat l_hat m_hat m_hat n_hat n2_hat a_hat b_hat c_hat d_hat

# =============================================================================
# Channels
# =============================================================================
channel 4 => inst n_hat_c  seq hat_seq
channel 5 => inst kick seq dmc_seq

play
