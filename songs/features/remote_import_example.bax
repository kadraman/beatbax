chip gameboy
bpm 140

# Preferred: chip-scoped leaf kits or concatenated kit (remote-safe; no nested imports)
import "github:kadraman/beatbax-instruments/main/gameboy/melodic.ins"
import "github:kadraman/beatbax-instruments/main/gameboy/drums.ins"
# One-shot full kit:
# import "github:kadraman/beatbax-instruments/main/gameboy/kit.ins"

# Legacy root paths (still published for compatibility)
# import "github:kadraman/beatbax-instruments/main/melodic.ins"
# import "github:kadraman/beatbax-instruments/main/percussion.ins"

# Branch / tag examples
# import "github:kadraman/beatbax-instruments/develop/gameboy/melodic.ins"
# import "github:kadraman/beatbax-instruments/v1.2.3/gameboy/melodic.ins"

# Local imports (relative to this song)
# import "local:lib/gameboy-common.ins"
# import "local:lib/gameboy-drums.ins"

# Local instrument overrides remote/imported instruments
inst gb_lead type=pulse1 duty=12 env=8,down

pat melody = C5 E5 G5 C6
pat bass_line = C3 . G2 .
pat drums = C7 . C7 . C7 C7 C7 .

seq melody_seq = melody * 4
seq bass_seq = (bass_line bass_line:oct(-1) )*2
seq drums_seq = drums*2

channel 1 => inst gb_lead   seq melody_seq
channel 2 => inst gb_bass   seq bass_seq
channel 4 => inst snare     pat drums_seq

play
